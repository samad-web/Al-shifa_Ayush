generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String
  role                   Role
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  bulkOperations         BulkOperation[]
  doctor                 Doctor?
  uploadedDocuments      Document[]
  sentMessages           Message[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  patient                Patient?
  pharmacist             Pharmacist?
  pharmacyDispenses      PharmacyDispense[]
  therapist              Therapist?
}

model Doctor {
  id                 String              @id @default(uuid())
  userId             String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clinic             String?
  fullName           String?
  profilePhoto       String?
  qualification      String?
  specialization     String?
  yearsExperience    Int?
  appointments       Appointment[]
  conversations      Conversation[]
  user               User                @relation(fields: [userId], references: [id])
  journeys           Journey[]
  prescriptions      Prescription[]
  videoPrescriptions VideoPrescription[]
}

model Therapist {
  id                 String              @id @default(uuid())
  userId             String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clinic             String?
  fullName           String?
  profilePhoto       String?
  qualification      String?
  specialization     String?
  yearsExperience    Int?
  appointments       Appointment[]
  availability       Availability[]
  conversations      Conversation[]
  journeys           Journey[]
  prescriptions      Prescription[]
  user               User                @relation(fields: [userId], references: [id])
  videoPrescriptions VideoPrescription[]
}

model Pharmacist {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String?
  profilePhoto    String?
  qualification   String?
  yearsExperience Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Patient {
  id                  String              @id @default(uuid())
  userId              String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  age                 Int?
  dob                 DateTime?
  fullName            String?
  gender              String?
  patientId           String?             @unique
  phoneNumber         String?
  therapyType         String?
  onboardingCompleted Boolean             @default(false)
  onboardingData      Json?
  zenPoints           Int                 @default(0)
  appointments        Appointment[]
  conversations       Conversation[]
  dailyCheckIns       DailyCheckIn[]
  documents           Document[]
  invoices            Invoice[]
  journeys            Journey[]
  user                User                @relation(fields: [userId], references: [id])
  payments            Payment[]
  pharmacyDispenses   PharmacyDispense[]
  prescriptions       Prescription[]
  triageSessions      TriageSession[]
  videoPrescriptions  VideoPrescription[]
}

model DailyCheckIn {
  id         String   @id @default(uuid())
  patientId  String
  painLevel  Int
  sleepHours Float
  mood       String
  notes      String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
}

model ExerciseVideo {
  id            String              @id @default(uuid())
  title         String
  description   String?
  videoUrl      String
  thumbnail     String?
  category      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  prescriptions VideoPrescription[]
}

model VideoPrescription {
  id          String        @id @default(uuid())
  patientId   String
  doctorId    String?
  therapistId String?
  videoId     String
  notes       String?
  createdAt   DateTime      @default(now())
  doctor      Doctor?       @relation(fields: [doctorId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  therapist   Therapist?    @relation(fields: [therapistId], references: [id])
  video       ExerciseVideo @relation(fields: [videoId], references: [id])

  @@index([patientId])
}

model Appointment {
  id               String         @id @default(uuid())
  patientId        String
  doctorId         String
  therapistId      String?
  date             DateTime
  status           String
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  consultationMode String         @default("OFFLINE")
  meetingLink      String?
  sessionNotes     String?
  triageSessionId  String?        @unique
  doctor           Doctor         @relation(fields: [doctorId], references: [id])
  patient          Patient        @relation(fields: [patientId], references: [id])
  therapist        Therapist?     @relation(fields: [therapistId], references: [id])
  triageSession    TriageSession? @relation(fields: [triageSessionId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([therapistId])
  @@index([status])
  @@index([date])
}

model Prescription {
  id             String     @id @default(uuid())
  patientId      String
  doctorId       String?
  therapistId    String?
  fileUrl        String?
  medicationName String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  doctor         Doctor?    @relation(fields: [doctorId], references: [id])
  patient        Patient    @relation(fields: [patientId], references: [id])
  therapist      Therapist? @relation(fields: [therapistId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([therapistId])
  @@index([createdAt])
}

model Availability {
  id          String    @id @default(uuid())
  therapistId String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  therapist   Therapist @relation(fields: [therapistId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id                   String  @id @default(uuid())
  userId               String  @unique
  emailEnabled         Boolean @default(true)
  smsEnabled           Boolean @default(false)
  pushEnabled          Boolean @default(true)
  appointmentReminders Boolean @default(true)
  systemAlerts         Boolean @default(true)
  prescriptionUpdates  Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id])
}

model Document {
  id              String         @id @default(uuid())
  patientId       String
  uploadedBy      String
  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  category        String
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  triageSessionId String?
  patient         Patient        @relation(fields: [patientId], references: [id])
  triageSession   TriageSession? @relation(fields: [triageSessionId], references: [id])
  uploader        User           @relation(fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@index([category])
  @@index([triageSessionId])
}

model Journey {
  id                String          @id @default(uuid())
  patientId         String
  doctorId          String
  therapistId       String?
  startDate         DateTime
  endDate           DateTime?
  status            String
  totalSessions     Int
  completedSessions Int             @default(0)
  progressNotes     String?
  treatmentGoals    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  doctor            Doctor          @relation(fields: [doctorId], references: [id])
  patient           Patient         @relation(fields: [patientId], references: [id])
  therapist         Therapist?      @relation(fields: [therapistId], references: [id])
  medications       MedicationLog[]

  @@index([patientId, status])
  @@index([doctorId])
}

model MedicationLog {
  id             String    @id @default(uuid())
  journeyId      String
  date           DateTime
  medicationName String
  dosage         String
  taken          Boolean   @default(false)
  takenAt        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  journey        Journey   @relation(fields: [journeyId], references: [id])

  @@index([journeyId, date])
}

model BulkOperation {
  id               String    @id @default(uuid())
  type             String
  initiatedBy      String
  status           String
  totalRecords     Int
  processedRecords Int       @default(0)
  failedRecords    Int       @default(0)
  errorLog         Json?
  fileUrl          String?
  resultFileUrl    String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  user             User      @relation(fields: [initiatedBy], references: [id])

  @@index([initiatedBy])
  @@index([status])
}

model Payment {
  id            String   @id @default(uuid())
  patientId     String
  amount        Float
  currency      String   @default("INR")
  status        String
  paymentMethod String?
  transactionId String?  @unique
  description   String?
  appointmentId String?
  invoiceUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  patient       Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model Medicine {
  id            String          @id @default(uuid())
  name          String
  brand         String?
  category      String?
  manufacturer  String?
  composition   String?
  description   String?
  price         Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  dispenseItems DispenseItem[]
  invoiceItems  InvoiceItem[]
  stocks        MedicineStock[]

  @@index([name])
}

model MedicineStock {
  id          String   @id @default(uuid())
  medicineId  String
  batchNumber String
  expiryDate  DateTime
  quantity    Int
  minStock    Int      @default(10)
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  medicine    Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
  @@index([expiryDate])
}

model PharmacyDispense {
  id             String         @id @default(uuid())
  patientId      String
  prescriptionId String?
  dispensedBy    String
  totalAmount    Float
  status         String         @default("COMPLETED")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          DispenseItem[]
  dispenser      User           @relation(fields: [dispensedBy], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([createdAt])
}

model DispenseItem {
  id         String           @id @default(uuid())
  dispenseId String
  medicineId String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  dispense   PharmacyDispense @relation(fields: [dispenseId], references: [id])
  medicine   Medicine         @relation(fields: [medicineId], references: [id])
}

model Invoice {
  id          String        @id @default(uuid())
  patientId   String
  totalAmount Float
  taxAmount   Float?        @default(0)
  discount    Float?        @default(0)
  netAmount   Float
  status      String        @default("UNPAID")
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  patient     Patient       @relation(fields: [patientId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  medicineId  String?
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  medicine    Medicine? @relation(fields: [medicineId], references: [id])
}

model TriageSession {
  id                 String       @id @default(uuid())
  patientId          String
  responses          Json
  severity           String
  suggestedSpecialty String?
  isEscalated        Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  appointment        Appointment?
  documents          Document[]
  patient            Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

model Conversation {
  id          String     @id @default(uuid())
  patientId   String
  doctorId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  therapistId String?
  doctor      Doctor?    @relation(fields: [doctorId], references: [id])
  patient     Patient    @relation(fields: [patientId], references: [id])
  therapist   Therapist? @relation(fields: [therapistId], references: [id])
  messages    Message[]

  @@unique([patientId, doctorId])
  @@unique([patientId, therapistId])
  @@index([patientId])
  @@index([doctorId])
  @@index([therapistId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

enum Role {
  ADMIN_DOCTOR
  DOCTOR
  THERAPIST
  PATIENT
  ADMIN
  PHARMACIST
}
