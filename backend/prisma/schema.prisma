generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  doctor    Doctor?
  patient   Patient?
  therapist Therapist?
  pharmacist Pharmacist?
  notifications Notification[]
  notificationPreference NotificationPreference?
  uploadedDocuments Document[]
  bulkOperations BulkOperation[]
  pharmacyDispenses PharmacyDispense[]
}

model Doctor {
  id              String         @id @default(uuid())
  userId          String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clinic          String?
  fullName        String?
  profilePhoto    String?
  qualification   String?
  specialization  String?
  yearsExperience Int?
  appointments    Appointment[]
  user            User           @relation(fields: [userId], references: [id])
  prescriptions   Prescription[]
  journeys        Journey[]
}

model Therapist {
  id              String         @id @default(uuid())
  userId          String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clinic          String?
  fullName        String?
  profilePhoto    String?
  qualification   String?
  specialization  String?
  yearsExperience Int?
  appointments    Appointment[]
  availability    Availability[]
  prescriptions   Prescription[]
  user            User           @relation(fields: [userId], references: [id])
  journeys        Journey[]
}

model Pharmacist {
  id              String         @id @default(uuid())
  userId          String         @unique
  fullName        String?
  profilePhoto    String?
  qualification   String?
  yearsExperience Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
}

model Patient {
  id            String         @id @default(uuid())
  userId        String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  age           Int?
  dob           DateTime?
  fullName      String?
  gender        String?
  patientId     String?        @unique
  phoneNumber   String?
  therapyType   String?
  appointments  Appointment[]
  user          User           @relation(fields: [userId], references: [id])
  prescriptions Prescription[]
  documents     Document[]
  journeys      Journey[]
  payments      Payment[]
  pharmacyDispenses PharmacyDispense[]
  invoices      Invoice[]
  triageSessions TriageSession[]
}

model Appointment {
  id          String     @id @default(uuid())
  patientId   String
  doctorId    String
  therapistId String?
  date        DateTime
  status      String
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  doctor           Doctor     @relation(fields: [doctorId], references: [id])
  patient          Patient    @relation(fields: [patientId], references: [id])
  therapist        Therapist? @relation(fields: [therapistId], references: [id])
  consultationMode String     @default("OFFLINE") // ONLINE or OFFLINE
  meetingLink      String?
  sessionNotes     String?
  triageSessionId  String?    @unique
  triageSession    TriageSession? @relation(fields: [triageSessionId], references: [id])
}

model Prescription {
  id             String     @id @default(uuid())
  patientId      String
  doctorId       String?
  therapistId    String?
  fileUrl        String?
  medicationName String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  doctor         Doctor?    @relation(fields: [doctorId], references: [id])
  patient        Patient    @relation(fields: [patientId], references: [id])
  therapist      Therapist? @relation(fields: [therapistId], references: [id])
}

model Availability {
  id          String    @id @default(uuid())
  therapistId String
  dayOfWeek   Int       // 0-6 (Sunday to Saturday)
  startTime   String    // HH:mm
  endTime     String    // HH:mm
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  therapist   Therapist @relation(fields: [therapistId], references: [id])
}

enum Role {
  ADMIN_DOCTOR
  DOCTOR
  THERAPIST
  PATIENT
  ADMIN
  PHARMACIST
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // APPOINTMENT_REMINDER, SYSTEM_ALERT, PRESCRIPTION_UPDATE, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?    // Additional context (appointmentId, etc.)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  
  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id                    String  @id @default(uuid())
  userId                String  @unique
  emailEnabled          Boolean @default(true)
  smsEnabled            Boolean @default(false)
  pushEnabled           Boolean @default(true)
  appointmentReminders  Boolean @default(true)
  systemAlerts          Boolean @default(true)
  prescriptionUpdates   Boolean @default(true)
  user                  User    @relation(fields: [userId], references: [id])
}

model Document {
  id          String   @id @default(uuid())
  patientId   String
  uploadedBy  String
  fileName    String
  fileUrl     String
  fileType    String   // PDF, JPEG, PNG, etc.
  fileSize    Int      // in bytes
  category    String   // MEDICAL_RECORD, LAB_RESULT, PRESCRIPTION, IMAGING, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id])
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  triageSessionId String?
  triageSession TriageSession? @relation(fields: [triageSessionId], references: [id])
  
  @@index([patientId])
  @@index([category])
  @@index([triageSessionId])
}

model Journey {
  id                String          @id @default(uuid())
  patientId         String
  doctorId          String
  therapistId       String?
  startDate         DateTime
  endDate           DateTime?
  status            String          // ACTIVE, COMPLETED, SUSPENDED, CANCELLED
  totalSessions     Int
  completedSessions Int             @default(0)
  progressNotes     String?
  treatmentGoals    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  patient           Patient         @relation(fields: [patientId], references: [id])
  doctor            Doctor          @relation(fields: [doctorId], references: [id])
  therapist         Therapist?      @relation(fields: [therapistId], references: [id])
  medications       MedicationLog[]
  
  @@index([patientId, status])
  @@index([doctorId])
}

model MedicationLog {
  id             String   @id @default(uuid())
  journeyId      String
  date           DateTime
  medicationName String
  dosage         String
  taken          Boolean  @default(false)
  takenAt        DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  journey        Journey  @relation(fields: [journeyId], references: [id])
  
  @@index([journeyId, date])
}

model BulkOperation {
  id               String    @id @default(uuid())
  type             String    // PATIENT_IMPORT, APPOINTMENT_BULK, PRESCRIPTION_BATCH
  initiatedBy      String
  status           String    // PENDING, IN_PROGRESS, COMPLETED, FAILED, ROLLED_BACK
  totalRecords     Int
  processedRecords Int       @default(0)
  failedRecords    Int       @default(0)
  errorLog         Json?     // Array of error objects
  fileUrl          String?   // Original uploaded file
  resultFileUrl    String?   // Result/error report file
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  user             User      @relation(fields: [initiatedBy], references: [id])
  
  @@index([initiatedBy])
  @@index([status])
}

model Payment {
  id            String   @id @default(uuid())
  patientId     String
  amount        Float
  currency      String   @default("INR")
  status        String   // PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod String?  // CARD, UPI, NET_BANKING, CASH
  transactionId String?  @unique
  description   String?
  appointmentId String?
  invoiceUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  patient       Patient  @relation(fields: [patientId], references: [id])
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId     String?

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model Medicine {
  id           String             @id @default(uuid())
  name         String
  brand        String?
  category     String?            // Tablet, Syrup, Injection, etc.
  manufacturer String?
  composition  String?
  description  String?
  price        Float
  stocks       MedicineStock[]
  dispenseItems DispenseItem[]
  invoiceItems InvoiceItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([name])
}

model MedicineStock {
  id          String   @id @default(uuid())
  medicineId  String
  batchNumber String
  expiryDate  DateTime
  quantity    Int
  minStock    Int      @default(10)
  location    String?  // Rack/Shelf location
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  medicine    Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
  @@index([expiryDate])
}

model PharmacyDispense {
  id             String         @id @default(uuid())
  patientId      String
  prescriptionId String?
  dispensedBy    String         // Staff ID (User ID)
  totalAmount    Float
  status         String         @default("COMPLETED") // COMPLETED, CANCELLED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  patient        Patient        @relation(fields: [patientId], references: [id])
  dispenser      User           @relation(fields: [dispensedBy], references: [id])
  items          DispenseItem[]

  @@index([patientId])
  @@index([createdAt])
}

model DispenseItem {
  id         String           @id @default(uuid())
  dispenseId String
  medicineId String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  dispense   PharmacyDispense @relation(fields: [dispenseId], references: [id])
  medicine   Medicine         @relation(fields: [medicineId], references: [id])
}

model Invoice {
  id          String        @id @default(uuid())
  patientId   String
  totalAmount Float
  taxAmount   Float?        @default(0)
  discount    Float?        @default(0)
  netAmount   Float
  status      String        @default("UNPAID") // PAID, UNPAID, PARTIAL
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  patient     Patient       @relation(fields: [patientId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  medicineId  String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  medicine    Medicine? @relation(fields: [medicineId], references: [id])
}

model TriageSession {
  id                 String       @id @default(uuid())
  patientId          String
  responses          Json         // Stores all questionnaire answers: painArea, severity, symptoms, etc.
  severity           String       // LOW, MEDIUM, HIGH, EMERGENCY
  suggestedSpecialty String?
  isEscalated        Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  patient            Patient      @relation(fields: [patientId], references: [id])
  appointment        Appointment?
  documents          Document[]

  @@index([patientId])
}
