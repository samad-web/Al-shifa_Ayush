generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  doctor    Doctor?
  patient   Patient?
  therapist Therapist?
}

model Doctor {
  id              String         @id @default(uuid())
  userId          String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clinic          String?
  fullName        String?
  profilePhoto    String?
  qualification   String?
  specialization  String?
  yearsExperience Int?
  appointments    Appointment[]
  user            User           @relation(fields: [userId], references: [id])
  prescriptions   Prescription[]
}

model Therapist {
  id              String         @id @default(uuid())
  userId          String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clinic          String?
  fullName        String?
  profilePhoto    String?
  qualification   String?
  specialization  String?
  yearsExperience Int?
  appointments    Appointment[]
  availability    Availability[]
  prescriptions   Prescription[]
  user            User           @relation(fields: [userId], references: [id])
}

model Patient {
  id            String         @id @default(uuid())
  userId        String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  age           Int?
  dob           DateTime?
  fullName      String?
  gender        String?
  patientId     String?        @unique
  phoneNumber   String?
  therapyType   String?
  appointments  Appointment[]
  user          User           @relation(fields: [userId], references: [id])
  prescriptions Prescription[]
}

model Appointment {
  id          String     @id @default(uuid())
  patientId   String
  doctorId    String
  therapistId String?
  date        DateTime
  status      String
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  doctor           Doctor     @relation(fields: [doctorId], references: [id])
  patient          Patient    @relation(fields: [patientId], references: [id])
  therapist        Therapist? @relation(fields: [therapistId], references: [id])
  consultationMode String     @default("OFFLINE") // ONLINE or OFFLINE
  meetingLink      String?
  sessionNotes     String?
}

model Prescription {
  id             String     @id @default(uuid())
  patientId      String
  doctorId       String?
  therapistId    String?
  fileUrl        String?
  medicationName String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  doctor         Doctor?    @relation(fields: [doctorId], references: [id])
  patient        Patient    @relation(fields: [patientId], references: [id])
  therapist      Therapist? @relation(fields: [therapistId], references: [id])
}

model Availability {
  id          String    @id @default(uuid())
  therapistId String
  dayOfWeek   Int       // 0-6 (Sunday to Saturday)
  startTime   String    // HH:mm
  endTime     String    // HH:mm
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  therapist   Therapist @relation(fields: [therapistId], references: [id])
}

enum Role {
  ADMIN_DOCTOR
  DOCTOR
  THERAPIST
  PATIENT
  ADMIN
}
